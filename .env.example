# Copy to .env and adjust.

# PostgreSQL connection
DATABASE_URL=postgres://alliancebb:change-me@127.0.0.1:5432/alliancebb

# Required on the installer page when set, so strangers can't claim a fresh install.
INSTALL_TOKEN=

# Live updates through a Mercure hub (built into FrankenPHP). Leave empty to use polling.
MERCURE_PUBLISH_URL=
MERCURE_PUBLIC_URL=/.well-known/mercure
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_TOPIC_PREFIX=abb/

# Show error details on error pages. Never enable on a public site.
APP_DEBUG=0
