# Your two test subdomains. Point both DNS A records at this machine first.
ALPHA_DOMAIN=alpha.example.com
BETA_DOMAIN=beta.example.com

# Let's Encrypt contact address for the HTTPS certificates.
ACME_EMAIL=you@example.com

# Fill these with random values, e.g. `openssl rand -hex 32` for each.
DB_PASSWORD=
INSTALL_TOKEN=
ALPHA_MERCURE_KEY=
BETA_MERCURE_KEY=
