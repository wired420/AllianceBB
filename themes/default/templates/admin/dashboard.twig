{% extends 'admin/layout.twig' %}
{% block admin %}
    <section class="panel">
        <h1 class="panel-title">Dashboard</h1>
        <div class="stat-row">
            <div class="stat"><span class="stat-value">{{ stats.users }}</span><span class="muted">users</span></div>
            <div class="stat"><span class="stat-value">{{ stats.forums }}</span><span class="muted">forums</span></div>
            <div class="stat"><span class="stat-value">{{ stats.topics }}</span><span class="muted">topics</span></div>
            <div class="stat"><span class="stat-value">{{ stats.posts }}</span><span class="muted">posts</span></div>
        </div>
        <p class="muted small">AllianceBB {{ version }} · PHP {{ php_version }} · {{ worker_mode ? 'FrankenPHP worker mode' : 'classic PHP mode' }} · live updates: {{ live_config().mode }}</p>
        {{ hook('admin.dashboard') }}
    </section>
{% endblock %}
